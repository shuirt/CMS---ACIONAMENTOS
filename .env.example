# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ALLOWED_OPERATOR_EMAILS: Lista de e-mails Google autorizados a acessar o sistema (separados por vírgula).
# Exemplo: "operador1@empresa.com,operador2@empresa.com,supervisor@empresa.com"
ALLOWED_OPERATOR_EMAILS=""

# GOOGLE_SHEETS_SPREADSHEET_ID: ID da planilha Google Sheets compartilhada do CMS (opcional se configurada via interface).
# Exemplo: "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"
GOOGLE_SHEETS_SPREADSHEET_ID=""
